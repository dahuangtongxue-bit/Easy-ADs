# Easy-ADs 工作台（/app）需要的环境变量 —— 与 easy-director 的 Netlify 站点同名同值，原样复制即可
# 改完环境变量后在 Netlify 手动 Trigger deploy

# 访问口令（工作台 Gate）
ACCESS_PASSWORD=

# 零克云 MaaS
MAAS_BASE_URL=https://api-model.gpulink.cc/v1
MAAS_API_KEY=                 # 原分组 key：场表文本模型、文生图
MAAS_VIDEO_25_API_KEY=        # xiaoma-sd25 分组 key：Seedance 2.5 视频 + 活体/素材接口
MAAS_VIDEO_BASE_URL=
MAAS_VIDEO_API_KEY=
MAAS_IMAGE_BASE_URL=
MAAS_IMAGE_API_KEY=
MAAS_RP_GROUP_ID=             # 真人数字人常驻素材组（可留空用代码默认值）

# 文本模型
CHAT_MODEL=
STORY_MODEL=
CHAT_THINKING=

# 图床与控制台
IMGBB_API_KEY=
CONSOLE_USER_ID=
CONSOLE_ACCESS_TOKEN=

# 积分与管理
CREDITS_ENABLED=
ADMIN_KEY=

# 视频模型锁定（一般留空）
VIDEO_MODEL=
VIDEO_LOCKED=
NEXT_PUBLIC_VIDEO_LOCKED=
